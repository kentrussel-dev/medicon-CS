APP_NAME=Medicon
APP_ENV=local
APP_KEY=base64:c7w9YqXp4V8aK9rE4+vA0F2d5J7l8P1m3Q6T9u8W4Z0=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8080,127.0.0.1,127.0.0.1:5173,127.0.0.1:8080
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=medicon_db
DB_USERNAME=medicon_user
DB_PASSWORD=medicon_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=medicon_cache_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notifications@medicon.health"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage (MinIO / S3 Compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=medicon-medical-attachments
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/medicon-medical-attachments

# Machine Learning Microservice
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_SECONDS=2.5
ML_HIGH_RISK_THRESHOLD=0.65
ML_MEDIUM_RISK_THRESHOLD=0.35

# Data Retention Compliance (in Days)
RETENTION_AUDIT_LOG_DAYS=2555 # 7 years HIPAA minimum
RETENTION_SOFT_DELETED_DAYS=365
